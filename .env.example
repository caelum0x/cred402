# Cred402 environment — copy to .env and fill in. .env is gitignored.
# Everything below is OPTIONAL: with nothing set, Cred402 runs fully in
# simulation/free-API mode (deterministic demo + 87 tests stay green). Each block
# activates a REAL integration when its keys are present.

# ── p8: real Casper Testnet ────────────────────────────────────────────────
# sim (default) keeps the in-memory ledger; testnet routes writes to a live node.
CRED402_CHAIN=sim
# Casper 2.0 testnet JSON-RPC (reads work with no key — used by `npm run casper:health`).
CRED402_NODE=https://node.testnet.casper.network/rpc
CRED402_CASPER_NODE=https://node.testnet.casper.network
CRED402_CHAIN_NAME=casper-test
# Casper Sidecar SSE event feed (casper-network/casper-sidecar). Unset → in-process
# EventBus. Set to consume a live node's events: npm run casper:sidecar
CRED402_SIDECAR_URL=http://127.0.0.1:19999
# Path to a funded Testnet secret-key PEM (faucet: https://testnet.cspr.live/tools/faucet).
# Required only for live deploys / writes. NEVER commit the key itself.
CRED402_SECRET_KEY=/absolute/path/to/secret_key.pem
CRED402_KEY_ALGO=ed25519

# ── p9: real x402 facilitator + data + MCP ─────────────────────────────────
# make-software/casper-x402 facilitator (x402 V2). Run it on :4022, then set this
# to verify/settle CEP-18 transfer_with_authorization payments for real.
# Unset → Cred402's built-in ed25519 x402 verifier (the default, no service needed).
CRED402_X402_FACILITATOR_URL=http://localhost:4022
# Open-Meteo solar/GHI is free and needs NO key (used live by api/rwa_data).
# Optional real EU power-market data (ENTSO-E) — request a token at transparency.entsoe.eu.
ENTSOE_API_TOKEN=
# The official MCP server (npm run mcp:sdk) needs no env — connect any MCP client.

# ── Algorand Global x402 Challenge ─────────────────────────────────────────
# Enables GET /v1/x402/credit-score/:agentId. With no pay-to address the route
# fails closed with 503; it never advertises a placeholder wallet or becomes free.
CRED402_ALGORAND_PAY_TO=
# Develop on testnet, then change to mainnet for the public challenge submission.
CRED402_ALGORAND_NETWORK=testnet
# 10,000 micro-USDC = 0.01 USDC. Must be a positive integer.
CRED402_ALGORAND_PRICE_MICRO_USDC=10000
# GoPlausible supports Algorand Testnet + Mainnet and Bazaar discovery.
CRED402_ALGORAND_FACILITATOR_URL=https://facilitator.goplausible.xyz
CRED402_ALGORAND_FACILITATOR_TIMEOUT_MS=10000
# Canonical public origin for Bazaar. Required and HTTPS on Mainnet.
CRED402_PUBLIC_URL=https://api.example.com
# Safe client/preflight settings. The expected receiver and exact price are
# independently checked before any signing; the maximum is a hard spend cap.
CRED402_ALGORAND_CLIENT_URL=http://localhost:4021/v1/x402/credit-score/EvidenceSellerAgent
CRED402_ALGORAND_CLIENT_NETWORK=testnet
# Public address only; used by x402:algorand:ready for read-only balance checks.
CRED402_ALGORAND_CLIENT_ADDRESS=
CRED402_ALGORAND_EXPECTED_PAY_TO=
CRED402_ALGORAND_EXPECTED_PRICE_MICRO_USDC=10000
CRED402_ALGORAND_MAX_PRICE_MICRO_USDC=10000
# Base64-encoded 64-byte private key. Used only by x402:algorand:pay after typed approval.
CRED402_ALGORAND_CLIENT_PRIVATE_KEY=

# ── p10: real RealFi (Stripe/Plaid) + real cross-chain (Base Sepolia) ──────
# Stripe TEST mode (real signature verification on the webhook route).
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Plaid SANDBOX (real API, no real bank).
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox
# Base Sepolia EVM satellite deploy (forge). Faucet: https://www.alchemy.com/faucets/base-sepolia
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
ARBITRUM_SEPOLIA_RPC_URL=
ETHERSCAN_API_KEY=
# Deploy inputs for contracts/evm/script/Deploy.s.sol (NEVER commit the key):
PRIVATE_KEY=0xYOUR_FUNDED_BASE_SEPOLIA_KEY
USDC_ADDRESS=0x036CbD53842c5426634e7929541eC2318f3dCF7e
CHAIN_CAIP2=eip155:84532

# ── KeeperHub — on-chain execution & reliability layer (The Last Mile) ──────
# With no key, Cred402 runs KeeperHub in deterministic sim (simulate → smart gas
# w/ backoff → private routing → audit trail). Set an org API key (Settings > API
# Keys) to execute for real against KeeperHub's MCP server and get a real tx hash.
# Create at https://app.keeperhub.com — docs https://docs.keeperhub.com/ai-tools/mcp-server
KEEPERHUB_API_KEY=kh_your_org_key
KEEPERHUB_API_URL=https://app.keeperhub.com/mcp
# MEV-protected private submission (default on). Set to 0 to submit publicly.
KEEPERHUB_PRIVATE_ROUTING=1
# Gas sponsorship on mainnet Ethereum (chain 1) — the agent pays nothing. Default off.
KEEPERHUB_GAS_SPONSORSHIP=0
# Force MPP (Tempo USDC.e) instead of the default x402 (Base USDC) pay-per-execution.
KEEPERHUB_MPP_ONLY=0

# ── Flare — interoperable FXRP credit + FTSO + FDC + Confidential Compute ───
# Sim by default. Set FLARE_RPC_URL to read the REAL FTSO XRP/USD feed on-chain.
FLARE_NETWORK=coston2
FLARE_RPC_URL=https://coston2-api.flare.network/ext/C/rpc
# Optional: pin FtsoV2 instead of resolving via FlareContractRegistry
# (0xaD67FE66660Fb8dFE9d6b1b4240d8650e30F6019, same on every Flare network).
FLARE_FTSOV2_ADDRESS=
# Real FDC (Flare Data Connector) verifier base for cross-chain payment attestation,
# e.g. https://fdc-verifiers-testnet.flare.network/verifier/xrp (we append /Payment/prepareRequest).
FLARE_FDC_VERIFIER_URL=
FLARE_FDC_API_KEY=
# Flare Confidential Compute (TEE) attestation service — returns an enclave quote.
FLARE_CC_ATTESTATION_URL=
# Deploy inputs for contracts/flare/script/DeployCoston2.s.sol (NEVER commit the key):
# Coston2 faucet (C2FLR + FXRP): https://faucet.flare.network/coston2
FXRP_ADDRESS=
FLARE_VAULT_ADDRESS=
CASPER_POLICY_KEY_HASH=
